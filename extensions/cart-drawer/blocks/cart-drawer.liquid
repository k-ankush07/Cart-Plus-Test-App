<link rel="stylesheet" href="{{ 'index.css' | asset_url }}">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<!-- Custom Cart Drawer App Wrapper -->
<div class="cart_drawer_app {{ block.id }}" id="cart-drawer-App-{{ block.id }}">
  <div class="custom-cart-drawer-background" id="drawer-bg-{{ block.id }}"></div>
  <div class="custom-cart-drawer" id="drawer-{{ block.id }}">
    <div class="cart-drawer-wrapp" id="drawer-wrapp-{{ block.id }}">
      <div class="drawer-header">
        <h3>Your Cart</h3>
        <button class="close-drawer" id="closeDrawer-{{ block.id }}">×</button>
      </div>
      <div class="drawer-content" id="drawerContent-{{ block.id }}"></div>
    </div>
  </div>
</div>

<script src="{{ 'cart-drawer.js' | asset_url }}"></script>

<script>

window.addEventListener("load", async () => {
  const enableDrawer = {{ block.settings.enable_drawer | json }};
  const blockId = "{{ block.id }}";
  const shopDomain = "{{ shop.domain }}";
  const apiUrl = 'https://wondering-aspect-reductions-freeze.trycloudflare.com';
    let data = null;

 try {
  const res = await fetch(`${apiUrl}/api/get-cart?shop=${shopDomain}`, { cache: "no-store" });
  const serverData = await res.json();

  if (serverData?.data) {
    data = serverData.data;
    localStorage.setItem("cartData", JSON.stringify(data)); 
    console.log("Current cart data:", data);
  } else {
    data = null;
    localStorage.removeItem("cartData");
  }
 } catch (err) {
  console.error("Fetch error:", err);
  data = JSON.parse(localStorage.getItem("cartData") || "null"); 
 }

const bgColor = data?.checkoutStyle?.bgColor || "#ffffff";
const headingColor = data?.checkoutStyle?.headingColor || "#000000";
let headerfontSize = data?.checkoutStyle?.headerfontSize || "20"; 
const bgDiv = document.getElementById(`drawer-${blockId}`);
const headerTitle = document.querySelector(`#drawer-${blockId} .drawer-header h3`);
const btnborderRadius = data?.checkoutStyle?.btnborderRadius || "0"; 
const checkoutStyle = data?.checkoutStyle;
const priceColor = data?.checkoutStyle?.priceColor || "#000000"; 
const buttonColor = data?.checkoutStyle?.buttonColor || "#000000"; 
const buttonTextColor = data?.checkoutStyle?.buttonTextColor || "#FFFFFF"; 

const upSellTitle = data?.product?.upSellTitle || "You may also like";
const upSelltext = data?.product?.upSelltext || "Add";
const upSellstyle = data?.product?.upSellstyle || "Horizontal";
const upSellAdd = data?.product?.upSellAdd || "Automatic";
const upSellTotal = data?.product?.upSellTotal || "1";
const isUpSellVisible = data?.product?.isUpSellVisible || "true";
const upSellTemplate = data?.product?.upSellTemplate || "center";
const cartProductIds = (data?.product?.productId || []).map(id => id.toString());

const discount = data?.discount || {};
const trustBages = data?.trustBages || {};
const checkoutSection = data?.checkoutSection || {};
const vipProduct = data?.vipProduct || {};
const showViPProduct = vipProduct.showViPProduct || "true";
const shippingProduct = data?.shippingProduct?.productIds || [];
const showShippingProduct = data?.shippingProduct?.showShippingProduct || true;

const cartItem = data?.cartItem || {};
const productNameSize = data?.cartItem?.productNameSize || 14;
const productPriceSize = data?.cartItem?.productPriceSize || 14;
const progressBar = data?.progressBar || {};

const additionalNote = data?.additionalNote || {};
const confirmationBox = data?.confirmationBox || {};

const announcement = data?.announcement || {};
const announcementHeight = announcement.announcementHeight || "50px";
const announcementPosition = announcement.announcementPosition || "Before";
const announcementTimer = announcement.announcementTimer || "05:00";
const announcementText = announcement.announcementText || "Limited time offer! Ends in {TIMER}";
const announcementFontSize = announcement.announcementFontSize || "14px";
const announcementBgColor = announcement.announcementBgColor || "#cce7ff";
const announcementTextColor = announcement.announcementTextColor || "#000";
const announcementBorderColor = announcement.announcementBorderColor || "#000";
const isAnnouncementVisible = announcement.isAnnouncementVisible === "true";

  const announcementHTML = isAnnouncementVisible
  ? `
  <div class="cart-announcement" 
       style="
          height: ${
            announcementHeight === "Slim" ? "40px" :
            announcementHeight === "Normal" ? "60px" : "80px"
          };
          background-color: ${announcementBgColor};
          color: ${announcementTextColor};
          border: 1px solid ${announcementBorderColor};
          font-size: ${announcementFontSize || 14}px;
          display: flex;
          align-items: center;
          justify-content: center;
          text-align: center;
          gap: 5px;
          margin: 10px 0;
       ">
    ${announcementText.replace("{TIMER}", ` <span class="announcement-timer">${announcementTimer}</span>`)}
  </div>
  `
  : "";

  if (!headerfontSize.toString().includes("px")) {
  headerfontSize = `${headerfontSize}px`;
  }

  if (bgDiv) bgDiv.style.backgroundColor = bgColor;
  if (headerTitle) {
  headerTitle.style.color = headingColor;
  headerTitle.style.fontSize = headerfontSize;
  }

  // Element References
  const drawer = document.getElementById(`drawer-${blockId}`);
  const bg = document.getElementById(`drawer-bg-${blockId}`);
  const closeBtn = document.getElementById(`closeDrawer-${blockId}`);
  const drawerContent = document.getElementById(`drawerContent-${blockId}`);
  const cartBubble = document.querySelector(".cart-count-bubble span[aria-hidden='true']");
  const isCartPage = window.location.pathname.includes("/cart");

  if (!drawer || !bg || !closeBtn || !drawerContent) return;

  // Hide Shopify default cart drawer (to prevent conflicts)
  const hideDefaultCartDrawer = () => {
    const defaultDrawer = document.querySelector("cart-drawer, #CartDrawer, .cart-drawer");
    if (defaultDrawer) {
      defaultDrawer.style.display = "none";
      defaultDrawer.classList.remove("active", "animate");
    }
  };

  hideDefaultCartDrawer();
  const observer = new MutationObserver(() => hideDefaultCartDrawer());
  observer.observe(document.body, { childList: true, subtree: true });

  // Detect and format currency from Shopify settings
  const moneyFormat = "{{ shop.money_format }}";
  const symbolMatch = moneyFormat.match(/^(.*?)\s*\{\{\s*amount[^\}]*\}\}/);
  const suffixMatch = moneyFormat.match(/\{\{\s*amount[^\}]*\}\}\s*(.*?)$/);
  const currencySymbol = symbolMatch ? symbolMatch[1].trim() : "";
  const currencySuffix = suffixMatch ? suffixMatch[1].trim() : "";

  const formatPrice = (amount) => {
    
    const formatted = amount.toFixed(2);
    return `${currencySymbol}${currencySymbol && !currencySymbol.endsWith('.') ? ' ' : ''}${formatted}${currencySuffix ? ' ' + currencySuffix : ''}`;
  };

// Fetch all products
const productsRes = await fetch("/products.json?limit=250");
const productsData = await productsRes.json();
let products = productsData.products;

// Filter or slice based on upsell type
if (upSellAdd === "Automatic") {
  products = products.slice(0, parseInt(upSellTotal) || 1);
} else {
  products = products.filter(product => cartProductIds.includes(product.id.toString()));
  products = products.slice(0, parseInt(upSellTotal) || products.length);
}

// Generate upsell HTML
const generateProductHTML = (products) => {
  const isHorizontal = upSellstyle.toLowerCase() === "horizontal";
  const layoutClass = isHorizontal ? "upsell-horizontal" : "upsell-vertical";

  let html = `
    <div class="upsell-section ${layoutClass}">
      <h3 class="upsell-title" style="color:${headingColor};">${upSellTitle}</h3>
      <div class="upsell-products-wrapper ${isHorizontal ? "slider-wrapper" : ""}">
  `;

  html += products.map((product, index) => {
    const firstImage = product.images?.[0]?.src || "";
    const title = product.title || "Untitled Product";

    const firstVariant = product.variants?.[0] || {};
    const originalPrice = parseFloat(firstVariant.compare_at_price) || null;
    const finalPrice = parseFloat(firstVariant.price) || 0;
    const formattedOriginal = originalPrice ? formatPrice(originalPrice) : "";
    const formattedFinal = formatPrice(finalPrice);

    const variantOptions = product.variants
      .map(
        (variant) => `<option value="${variant.id}">
          ${variant.title} - ${formatPrice(parseFloat(variant.price))}
        </option>`
      )
      .join("");

    const templateClass =
      upSellTemplate === "left"
        ? "left-template"
        : upSellTemplate === "right"
        ? "right-template"
        : "center-template";

    let buttonRadius = btnborderRadius.toString().includes("px")
       ? btnborderRadius
     : `${btnborderRadius}px`;

    const buttonHTML =
      upSellTemplate === "center"
        ? `<button class="add-to-cart-btn" data-product-id="${product.id}" data-variant-id="${firstVariant.id}"
         style="border-radius: ${buttonRadius}; background-color: ${buttonColor}; color:${buttonTextColor};">
            ${upSelltext}
          </button>`
        : `<button class="add-to-cart-btn left-right" data-product-id="${product.id}" data-variant-id="${firstVariant.id}"
         style="border-radius: ${buttonRadius}; background-color: ${buttonColor}; color:${buttonTextColor};">
            +
          </button>`;

    return `
      <div class="product-card ${layoutClass} ${templateClass} ${isHorizontal ? "slide" : ""}" data-index="${index}">
        <img src="${firstImage}" alt="${title}" class="product-img" />
        <div class="product-details">
          <h4 class="product-title" style="font-size: ${productNameSize}px;">${title}</h4>
          <div class="product-prices">
            ${
              originalPrice && originalPrice > finalPrice
                ? `<s class="old-price">${formattedOriginal}</s> 
                <span class="new-price" style="color: ${priceColor}; font-size:${productPriceSize}px;">${formattedFinal}</span>`
                : `<span class="new-price" style="color: ${priceColor}; font-size:${productPriceSize}px;">${formattedFinal}</span>`
            }
          </div>
          <select class="variant-select" data-product-id="${product.id}">
            ${variantOptions}
          </select>
        </div>
        ${buttonHTML}
      </div>
    `;
  }).join("");

  html += `
      </div>
      ${
        isHorizontal
          ? `<button class="slider-btn prev">‹</button>
             <button class="slider-btn next">›</button>`
          : ""
      }
    </div>
  `;

  return html;
};

// Attach listeners to the main wrapper instead of drawerContent
const drawerWrapper =
  document.getElementById(`drawer-${blockId}`) ||
  document.getElementById(`drawer-wrapp-${blockId}`) ||
  drawerContent;

// --- Variant Change Event ---
drawerWrapper.addEventListener("change", (e) => {
  if (!e.target.classList.contains("variant-select")) return;

  const select = e.target;
  const productCard = select.closest(".product-card");
  const selectedVariantId = select.value;
  const productId = select.dataset.productId;
  const product = products.find(p => p.id.toString() === productId);
  if (!product) return;

  const variant = product.variants.find(v => v.id.toString() === selectedVariantId);
  if (!variant) return;

  // Update price
  const priceContainer = productCard.querySelector(".product-prices");
  const originalPrice = parseFloat(variant.compare_at_price) || null;
  const finalPrice = parseFloat(variant.price) || 0;
  const formattedOriginal = originalPrice ? formatPrice(originalPrice) : "";
  const formattedFinal = formatPrice(finalPrice);

  priceContainer.innerHTML =
    originalPrice && originalPrice > finalPrice
      ? `<s class="old-price">${formattedOriginal}</s> <span class="new-price">${formattedFinal}</span>`
      : `<span class="new-price">${formattedFinal}</span>`;

  // Update image
  const img = productCard.querySelector(".product-img");
  let variantImageSrc = "";
  if (variant.featured_image?.id) {
    const matchedImage = product.images.find(i => i.id === variant.featured_image.id);
    if (matchedImage) variantImageSrc = matchedImage.src;
  }
  if (!variantImageSrc && variant.image_id) {
    const matchedImage = product.images.find(i => i.id === variant.image_id);
    if (matchedImage) variantImageSrc = matchedImage.src;
  }
  if (!variantImageSrc) {
    variantImageSrc = product.images?.[0]?.src || "";
  }
  img.src = variantImageSrc;

  // Update correct add button
  const btn = productCard.querySelector(".add-to-cart-btn");
  if (btn) btn.dataset.variantId = variant.id;
});

// --- Click Event (slider + add-to-cart) ---
drawerWrapper.addEventListener("click", async (e) => {
  const slider = drawerWrapper.querySelector(".slider-wrapper");
  const slideAmount = 300;

  if (e.target.classList.contains("slider-btn") || e.target.closest(".slider-btn")) {
    e.preventDefault();
    const btn = e.target.classList.contains("slider-btn")
      ? e.target
      : e.target.closest(".slider-btn");
    if (btn.classList.contains("prev")) slider.scrollBy({ left: -slideAmount, behavior: "smooth" });
    if (btn.classList.contains("next")) slider.scrollBy({ left: slideAmount, behavior: "smooth" });
    return;
  }

  const addBtn = e.target.closest(".add-to-cart-btn");
  if (!addBtn) return;

  const variantId = addBtn.dataset.variantId;
  if (!variantId) return;

  addBtn.disabled = true;
  const originalText = addBtn.textContent;
  addBtn.textContent = "Adding...";

  try { await fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: variantId, quantity: 1 }),
    });

    addBtn.textContent = "Added!";
    setTimeout(() => {
      addBtn.textContent = originalText;
      addBtn.disabled = false;
    }, 500);

    if (typeof fetchCartItems === "function") {
      fetchCartItems({
        drawerContent, drawer, blockId, formatPrice, generateProductHTML,
        updateCartQuantity, removeCartItem, updateCartBubble, products,
        isUpSellVisible, upSellTemplate, announcementHTML,announcementPosition,
        isAnnouncementVisible, btnborderRadius, checkoutStyle, discount, cartItem,
        trustBages, checkoutSection,vipProduct,generateShipping,products1, shippingProduct,
        showShippingProduct, progressBar, additionalNote, confirmationBox
      });
    }

  } catch (err) {
    console.error("❌ Error adding to cart:", err);
    addBtn.textContent = "Error!";
    setTimeout(() => {
      addBtn.textContent = originalText;
      addBtn.disabled = false;
    }, 1000);
  }
 });

   function initCartListener() {
    document.addEventListener('cart:updated', function(e) {
      console.log('Cart has been updated!', e.detail);
      if (typeof fetchCartItems === "function") {
        fetchCartItems({
          drawerContent, drawer, blockId, formatPrice, generateProductHTML,
          updateCartQuantity, removeCartItem, updateCartBubble, products,
          isUpSellVisible, upSellTemplate, announcementHTML, announcementPosition,
          isAnnouncementVisible, btnborderRadius, checkoutStyle, discount, cartItem,
          trustBages, checkoutSection, vipProduct, generateShipping, products1, shippingProduct,
          showShippingProduct, progressBar, additionalNote, confirmationBox
        });
      }
    });
  }

  // Override fetch to dispatch cart:updated
  (function() {
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
      const response = await originalFetch.apply(this, args);
      if (args[0].includes('/cart/add') || args[0].includes('/cart/change') || args[0].includes('/cart/clear')) {
        try {
          const data = await response.clone().json();
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        } catch(err) { console.warn("Cart update event failed:", err); }
      }
      return response;
    };
  })();
  initCartListener();

  // Hide Drawer Function
  const hideDrawer = () => {
    drawer.style.transform = "translateX(100%)";
    bg.style.opacity = "0";
    document.body.classList.remove("overflow-hidden", "cart-drawer-gradient");
    bg.addEventListener("transitionend", function handleEnd() {
      if (bg.style.opacity === "0") {
        bg.style.visibility = "hidden";
        bg.style.display = "none";
      }
      bg.removeEventListener("transitionend", handleEnd);
    });
  };

// shiiping protection

const productsRes1 = await fetch("/products.json?limit=250");
const productsData1 = await productsRes1.json();
const products1 = productsData1.products;
const numericId = Number(shippingProduct[0]);
const matchedProduct = products1.find(p => p.id === numericId);

const generateShipping = (products, cart) => {
  if (showShippingProduct === 'false') return "";
  const numericId = Number(shippingProduct[0]);
  const matchedProduct = products.find(p => p.id === numericId);
  if (!matchedProduct) return "";

  const price = Number(matchedProduct.variants?.[0]?.price) || 0;

  const inCart = cart.items.some(
    (item) => item.variant_id == matchedProduct.variants?.[0]?.id
  );

  return `
    <div class ="shipping-protection" style="padding:10px;">
      <div class="cart-line-item_image-custom">
        <img src="${matchedProduct.images[0]?.src || ''}" alt="${matchedProduct.title}" width="200"/>
      </div>
      <div class="cart-item-details">
        <a href="/products/${matchedProduct.handle}" target="_blank"
        rel="noopener noreferrer" style="text-decoration:none; color:${headingColor || '#000'}; font-size:${productNameSize}px;">
          <p class="cart-item-title">${matchedProduct.title}</p>
        </a>
         <p class="cart-item-price" style="color: ${priceColor}; font-size:${productPriceSize}px;">
          ${formatPrice(price)}
        </p>
        <label class="switch-vip">
          <input type="checkbox" class="shipping-toggle" data-variant-id="${matchedProduct.variants?.[0]?.id}" ${inCart ? "checked" : ""} />
           <span className="slider-vip"></span>
        </label>
      </div>
    </div>
  `;
};

  // Vip Product Function
 const autoAddVIP = async () => {
  if (vipProduct?.showViPProduct !== "true") {
    console.log("🚫 VIP auto-add disabled (showViPProduct = false)");
    return; 
  }

  if (vipProduct?.productIds?.length) {
    const numericVipId = Number(vipProduct.productIds[0]);
    const productsResItem = await fetch("/products.json?limit=250");
    const { products: allProducts } = await productsResItem.json();

    const vip = allProducts.find((p) => Number(p.id) === numericVipId);
    const vipVariantId = vip?.variants?.[0]?.id ?? null;

    if (vipVariantId) {
      const cartBeforeVIP = await fetch("/cart.js").then((r) => r.json());
      const alreadyInCart = cartBeforeVIP.items.some(
        (item) => Number(item.variant_id) === vipVariantId
      );

      if (!alreadyInCart) {
        const addRes = await fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: vipVariantId, quantity: 1 }),
        });

        if (addRes.ok) console.log("✔ VIP auto-added when drawer opened");
        else console.error("❌ Failed to add VIP");
      } else {
        console.log("ℹ VIP already in cart — not adding again.");
      }
    }
  }
};

 // Show Drawer Function
  const showDrawer = async () => {
  bg.style.display = "block";
  bg.style.visibility = "visible";
  bg.style.opacity = "1";
  drawer.style.transform = "translateX(0)";
  document.body.classList.add("overflow-hidden", "cart-drawer-gradient");
   await autoAddVIP(); 
  if (typeof fetchCartItems === "function") {
    fetchCartItems({
      drawerContent, drawer, blockId, formatPrice, generateProductHTML,
      updateCartQuantity, removeCartItem, updateCartBubble, products,
      isUpSellVisible, upSellTemplate, announcementHTML, announcementPosition,
      isAnnouncementVisible, btnborderRadius, checkoutStyle, discount, cartItem,
      trustBages, checkoutSection, vipProduct,generateShipping,products1, shippingProduct,
      showShippingProduct, progressBar, additionalNote, confirmationBox
    });
  } else {
    console.warn("⚠️ fetchCartItems not loaded yet — drawer shown without items");
  }
};

  // Update Cart Count Bubble
  async function updateCartBubble(count) {
  const cartBubble = document.querySelector(".cart-count-bubble span[aria-hidden='true']");
  if (cartBubble) {
    cartBubble.textContent = count;
    const hiddenText = cartBubble.nextElementSibling;
    if (hiddenText) hiddenText.textContent = `${count} items`;
  } else {
    console.warn("Cart bubble not found in DOM");
  }
 }

   const cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
   cartIcon.addEventListener('click', e => {
    e.preventDefault();
    e.stopImmediatePropagation(); 
    showDrawer();
  });
  }

  // Update Cart Quantity
  async function updateCartQuantity(key, quantity) {
    try {
      const res = await fetch("/cart/change.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: key, quantity }),
      });
      const updatedCart = await res.json();
      await updateCartBubble(updatedCart.item_count);
      if (typeof fetchCartItems === "function") {
        fetchCartItems({
          drawerContent, drawer, blockId, formatPrice, generateProductHTML,
          updateCartQuantity, removeCartItem, updateCartBubble, products,isUpSellVisible,
          upSellTemplate, announcementHTML,announcementPosition,isAnnouncementVisible,
          btnborderRadius, checkoutStyle, discount, cartItem,trustBages, checkoutSection,
          vipProduct,generateShipping,products1, shippingProduct, showShippingProduct,
          progressBar, additionalNote, confirmationBox
        });
      }
    } catch (err) {
      console.error("Error updating quantity:", err);
    }
  }

   // Remove product
   async function removeCartItem(key) {
    try {
      const res = await fetch("/cart/change.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: key, quantity: 0 }),
      });
      const updatedCart = await res.json();
      await updateCartBubble(updatedCart.item_count);
      if (typeof fetchCartItems === "function") {
        fetchCartItems({
          drawerContent, drawer, blockId, formatPrice, generateProductHTML,
          updateCartQuantity, removeCartItem, updateCartBubble, products,
          isUpSellVisible, upSellTemplate, announcementHTML,announcementPosition,
          isAnnouncementVisible, btnborderRadius, checkoutStyle, discount, cartItem,
          trustBages, checkoutSection, vipProduct,generateShipping,products1, shippingProduct,
          showShippingProduct, progressBar, additionalNote, confirmationBox
        });
      }
    } catch (err) {
      console.error("Error removing item:", err);
    }
  }

  // Drawer Controls
  hideDrawer();
  bg.addEventListener("click", hideDrawer);
  closeBtn.addEventListener("click", hideDrawer);

  // Open Drawer When Cart Button Clicked
  document.querySelectorAll('a[href*="/cart"], .cart-icon').forEach(el => {
    el.addEventListener("click", (e) => {
       e.preventDefault(); e.stopImmediatePropagation();
      showDrawer();
    });
  });

  // Add to Cart Event Listener
document.querySelectorAll('form[action*="/cart/add"]').forEach(form => {
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    e.stopImmediatePropagation();

    const submitBtn = form.querySelector('[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const formData = new FormData(form);
      await fetch("/cart/add.js", { method: "POST", body: formData });
      showDrawer();
    } catch (err) {
      console.error("Error adding to cart:", err);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  }, { capture: true }); 
});

});
</script>

{% schema %}
{
  "name": "Cart Drawer by HubSyntax",
  "target": "body"
}
{% endschema %}
